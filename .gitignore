# Terraform state files — contain sensitive data (including your private key,
# since tls_private_key writes it into state) and are meant to be remote (S3), not in git
infra/*.tfstate
infra/*.tfstate.*
infra/.terraform.tfstate.lock.info

# Local .terraform directory — downloaded providers/modules, regenerated by `terraform init`
infra/.terraform/

# Terraform plan output files — binary, environment-specific, shouldn't be versioned
infra/*.tfplan
infra/tfplan

# Variable files that may contain secrets/environment-specific overrides
infra/*.tfvars
infra/*.tfvars.json
!infra/*.tfvars.example

# Crash logs
infra/crash.log
infra/crash.*.log

# Override files — used for local dev overrides, not meant to be committed
infra/override.tf
infra/override.tf.json
infra/*_override.tf
infra/*_override.tf.json

# CLI config that may contain credentials
infra/.terraformrc
infra/terraform.rc